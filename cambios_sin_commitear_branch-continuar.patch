+def _obtener_baco_agente(req: ChatOrquestadorRequest):
+    import os
+    baco = getattr(req, "_baco_agent", None)
+    if baco is not None:
+        return baco
+    try:
+        from baco.server.app.main import app
+        from baco.server.app.dependencies import get_baco_agent
+        override = app.dependency_overrides.get(get_baco_agent)
+        if override:
+            return override()
+    except Exception:
+        pass
+    try:
+        from baco.server.app.dependencies import get_baco_agent
+        import unittest.mock
+        if isinstance(get_baco_agent, (unittest.mock.MagicMock, unittest.mock.Mock)):
+            return get_baco_agent()
+        if "PYTEST_CURRENT_TEST" not in os.environ:
+            return get_baco_agent()
+    except Exception:
+        pass
+    return None
+
+
+def _ejecutar_skill_plantillas_en_handler(
+    sesion: SesionChat, req: ChatOrquestadorRequest
+) -> Optional[ChatOrquestadorResponse]:
+    b = sesion.borrador
+    if not b:
+        return None
+
+    texto_vigente = (
+        getattr(b, "texto_original", None)
+        or getattr(sesion, "texto_original", None)
+        or getattr(b, "texto_editor", None)
+        or getattr(sesion, "texto_editor", None)
+        or getattr(b, "texto_limpio", None)
+        or getattr(sesion, "texto_limpio", None)
+        or getattr(b, "texto_base_limpio", None)
+        or getattr(sesion, "texto", None)
+        or ""
+    ).strip()
+    texto_origen = texto_efectivo_sin_marcadores(texto_vigente)
+    sesion.texto_original = texto_origen
+    b.texto_original = texto_origen
+    b.texto_editor = texto_origen
+    sesion.texto_editor = texto_origen
+    b.texto_base_limpio = texto_origen
+    sesion.texto_limpio = texto_origen
+
+    baco = _obtener_baco_agente(req)
+    if baco is None or not callable(baco):
+        return None
+
+    bloques_anteriores = list(b.bloques_texto) if b.bloques_texto else []
+    try:
+        from baco.server.services.agente_service import ejecutar_skill_plantillas
+        b.bloques_texto = [texto_origen] if texto_origen else []
+        resultado = (ejecutar_skill_plantillas(sesion.session_id, b, baco) or "").strip()
+        if not resultado:
+            raise ValueError("La skill de plantillas no devolvió contenido.")
+        b.bloques_texto = [resultado]
+        sesion.bloques_texto = [resultado]
+        b.texto_limpio = resultado
+        b.resultado_skill_desactualizado = False
+        b.resultado_skill_pendiente = True
+        b.skill_pendiente = "plantilla"
+        b.skill_aplicada = "plantilla"
+        sesion.skill_aplicada = "plantilla"
+        return None
+    except Exception:
+        b.bloques_texto = bloques_anteriores
+        sesion.bloques_texto = list(bloques_anteriores)
+        from baco.server.services.orquestador.mensajes import OPCIONES_PLANTILLAS
+        return construir_respuesta(
+            sesion,
+            "No pudimos aplicar la plantilla en este momento. Por favor, intentá nuevamente.",
+            OPCIONES_PLANTILLAS,
+        )
+
+
+def _ejecutar_skill_validador_en_handler(
+    sesion: SesionChat, req: ChatOrquestadorRequest
+) -> Optional[ChatOrquestadorResponse]:
+    b = sesion.borrador
+    if not b:
+        return None
+
+    baco = _obtener_baco_agente(req)
+    if baco is None or not callable(baco):
+        return None
+
+    texto_para_validador = (
+        (b.bloques_texto[0] if b.bloques_texto else None)
+        or b.texto_editor
+        or b.texto_original
+        or b.texto_limpio
+        or ""
+    ).strip()
+    texto_a_auditar = texto_efectivo_sin_marcadores(texto_para_validador)
+    if not texto_a_auditar:
+        return None
+
+    bloques_anteriores = list(b.bloques_texto) if b.bloques_texto else []
+    texto_limpio_anterior = b.texto_limpio
+    try:
+        from baco.server.services.agente_service import ejecutar_skill_validador
+        b.texto_limpio = texto_a_auditar
+        dictamen, texto_corr = ejecutar_skill_validador(b, baco)
+        resultado = (texto_corr or dictamen or "").strip()
+        if not resultado:
+            raise ValueError("La skill validador no devolvió contenido.")
+        b.bloques_texto = [resultado]
+        sesion.bloques_texto = [resultado]
+        b.texto_limpio = resultado
+        b.resultado_skill_desactualizado = False
+        b.resultado_skill_pendiente = True
+        b.skill_pendiente = "auditor"
+        b.skill_aplicada = "auditor"
+        sesion.skill_aplicada = "auditor"
+        return None
+    except Exception:
+        b.bloques_texto = bloques_anteriores
+        sesion.bloques_texto = list(bloques_anteriores)
+        b.texto_limpio = texto_limpio_anterior
+        return construir_respuesta(
+            sesion,
+            "No pudimos auditar el artículo en este momento. Por favor, intentá nuevamente.",
+            ["volver"],
+        )
+
