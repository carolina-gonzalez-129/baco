# Copiá este archivo a .env y completá los valores.
# No uses rutas absolutas de tu máquina: el repo tiene que correr en otra PC y en Docker.

# ---------------------------------------------------------------------------
# Obligatorias: sin estas el servidor NO arranca (RuntimeError al importar)
# ---------------------------------------------------------------------------
# Autenticación de la API (header X-API-Key o Authorization: Bearer)
API_KEY_SERVIDOR=
# HTTP Basic Auth para /docs, /openapi.json y /redoc
DOCS_USER=
DOCS_PASSWORD=
# Usuario PostgreSQL de solo lectura (pool del chat). schema_completo.sql crea
# el rol baco_readonly con DB_RO_PASSWORD si todavía no existe.
# El nombre está fijo en el SQL: no lo cambies (reconstruir_db.py aborta si no es baco_readonly).
DB_RO_USER=baco_readonly
DB_RO_PASSWORD=

# ---------------------------------------------------------------------------
# Obligatorias según el flujo: rompen al usarse si faltan
# ---------------------------------------------------------------------------
# Usuario de escritura de PostgreSQL (reconstruir_db, ingesta, embeddings, sincronización)
DB_USER=postgres
DB_PASSWORD=
# Modelo del agente (skills plantillas / validador) vía OpenRouter
OPEN_ROUTER_API_KEY=
# Discourse (ingesta, descarga y sincronización de artículos)
DISCOURSE_URL=https://bc-dev.finneg.com
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system

# ---------------------------------------------------------------------------
# Con default en el código (el valor de abajo es el default)
# Si una variable numérica queda definida vacía (VAR=) rompe: comentala en vez de vaciarla.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baco_db
# Cota máxima de caracteres del texto para usar las skills (plantillas / validador)
BACO_TEXTO_MAX=6687
# Caché en disco de respuestas de las skills (data/cache_skills.json); "0" la desactiva
BACO_CACHE_SKILLS=1
# Hilos de onnxruntime para los embeddings
ONNX_INTRA_OP_THREADS=2

# ---------------------------------------------------------------------------
# Opcionales (descomentar solo si hace falta)
# ---------------------------------------------------------------------------
# Orígenes CORS separados por coma. Default: localhost/127.0.0.1 en puertos 3000 y 5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex de orígenes dinámicos (ej. túneles de Cloudflare)
# CORS_ORIGIN_REGEX=https://.*\.trycloudflare\.com
# Directorio de datos (descargas, backups y temp_sesiones). Default: <raíz del repo>/data
# También ubica data/cache_skills.json y el default de RUTA_ARTICULOS_JSON.
# Si la definís, usá una ruta absoluta del entorno donde corre (ej. /app/data en Docker):
# una ruta relativa se resuelve desde el directorio de trabajo, no desde el repo.
# DATA_DIR=/app/data
# JSON de artículos para reconstruir_db.py. Default: <DATA_DIR>/articulos.json
# Misma advertencia que DATA_DIR: no la definas salvo que el archivo esté en otro lado.
# RUTA_ARTICULOS_JSON=/app/data/articulos.json
# Modelo y gateway del agente (compatible con la API de OpenAI)
# LLM_MODEL_ID=openrouter/free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Discourse público para traer el artículo en tiempo real al enriquecer (no es DISCOURSE_URL)
# DISCOURSE_PUBLIC_URL=https://bc.finneg.com

# ---------------------------------------------------------------------------
# Solo tests (opcionales)
# ---------------------------------------------------------------------------
# DSN para test_postgresql_normalizar_texto_si_se_configura (si falta, se saltea)
# BACO_TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/baco_db
# "1" habilita el test de carga real de modelos ONNX
# RUN_ONNX_INTEGRATION=1
# Segundos de pausa en el test de integración para inspeccionar el contenedor
# PAUSA_DOCKER=45
