# ============================================================================
# BACO - Configuración de Entorno (Ejemplo para Modo Demo / Local)
# Copiar este archivo a `.env` antes de levantar con Docker Compose o ejecutar
# el servidor MCP:
#   cp .env.example .env
# ============================================================================

# --- Conexión a PostgreSQL (pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baco_db

# Usuario administrador (usado por Docker al inicializar el esquema y seed)
DB_USER=postgres
DB_PASSWORD=changeme_admin_local

# Usuario de SOLO LECTURA (requerido obligatoriamente por el servidor MCP y API)
DB_RO_USER=baco_readonly
DB_RO_PASSWORD=changeme_readonly_local

# --- Optimización de inferencia ONNX ---
ONNX_INTRA_OP_THREADS=2
